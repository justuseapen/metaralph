#!/usr/bin/env node

/**
 * MetaRalph CLI executable
 *
 * This script bootstraps the CLI using tsx to run TypeScript directly.
 * For production, you would compile TypeScript and run the compiled JS.
 */

import { spawn } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import * as path from 'node:path';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const cliPath = path.resolve(__dirname, '../src/cli/index.ts');

// Run the CLI with tsx
const child = spawn(
  'npx',
  ['tsx', cliPath, ...process.argv.slice(2)],
  {
    stdio: 'inherit',
    cwd: path.resolve(__dirname, '..'),
  }
);

child.on('exit', (code) => {
  process.exit(code ?? 0);
});
